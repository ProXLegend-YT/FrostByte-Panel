# FrostByte Panel — environment configuration
# Copy this file to .env and fill in real values before starting the panel.

# REQUIRED. A long random secret used to sign session and API tokens.
# Generate one with: openssl rand -hex 32
# The panel will refuse to start without this set.
JWT_SECRET=

# Port the panel listens on. Defaults to 3000 if unset.
PORT=3000

# Set to "production" when deploying for real use. This enables the built
# frontend bundle instead of the Vite dev server, and tightens CORS defaults.
NODE_ENV=development

# REQUIRED in production. Comma-separated list of origins allowed to make
# browser requests to this panel, e.g.:
# ALLOWED_ORIGINS=https://panel.example.com,https://admin.example.com
ALLOWED_ORIGINS=
