# FrostByte Panel — environment configuration
# Copy this file to .env and fill in real values before starting the panel.

# REQUIRED. A long random secret used to sign session and API tokens.
# Generate one with: openssl rand -hex 32
# The panel will refuse to start without this set.
JWT_SECRET=

# Port the panel listens on. Defaults to 3000 if unset.
PORT=3000

# Set to "production" when deploying for real use. This enables the built
# frontend bundle instead of the Vite dev server, and tightens CORS defaults.
NODE_ENV=development

# REQUIRED in production. Comma-separated list of origins allowed to make
# browser requests to this panel, e.g.:
# ALLOWED_ORIGINS=https://panel.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# How server processes actually run. "docker" (default) uses real per-server
# containers with enforced memory/CPU limits — this is what you want on any
# host where it's available. "local" runs servers as plain native child
# processes instead; use this only if this host doesn't allow Docker's own
# container networking to initialize (some managed VPS/PaaS platforms block
# this even when running as root). install.sh asks about this during setup
# and writes the answer here — you shouldn't normally need to edit this by
# hand unless you're changing an existing install's runtime after the fact.
RUNTIME_MODE=docker
